# 이 파일을 .env 로 복사한 뒤 값을 채웁니다. .env 는 커밋되지 않습니다.

# MariaDB (운영용)
DB_HOST=
DB_PORT=3306
DB_NAME=folio
DB_USER=folio
DB_PASSWORD=
# TLS 로 접속하려면 true (같은 NAS 내부망이면 비워 둠)
DB_SSL=

# MariaDB (자동 테스트용 — 테스트가 내용을 지우므로 운영용과 반드시 다른 DB)
TEST_DB_NAME=folio_test

# 로그인 (운영 모드 필수. deploy/README.md 참고)
# PUBLIC_URL=https://<도메인>, SESSION_SECRET=32자 이상 무작위 문자열
PUBLIC_URL=
ADMIN_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# AI (14단계 때 채움)
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
